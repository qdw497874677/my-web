HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/linjian.sqlite
UPLOAD_DIR=./uploads
FRONTEND_ORIGIN=http://localhost:5173
# 仅 owner:init 命令读取；应用长期运行不需要保留密码环境变量。
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-long-random-password
SESSION_TTL_DAYS=30
# production 默认 true；仅本地 HTTP 开发时设 false。
COOKIE_SECURE=false
# 仅自动化测试/前端 E2E 可用，普通启动不会自动 seed。
SEED_ON_START=false
# 可选：不设置就关闭 AI 生图插件。填写配置文件路径，不在 JSON 中写 API 密钥。
# AI_IMAGES_CONFIG=./data/ai-images.json
# OPENAI_API_KEY=
# GEMINI_API_KEY=
