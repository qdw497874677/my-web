{
  "name": "linjian-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "oxlint src test",
    "test": "vitest run",
    "start": "node dist/server.js",
    "db:init": "tsx src/commands/init.ts",
    "owner:init": "tsx src/commands/owner-init.ts",
    "db:seed": "tsx src/commands/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^11.1.0",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "oxlint": "^1.71.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
